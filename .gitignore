# -------------------------------------------------------
# castle-remembers-jaguar .gitignore
# -------------------------------------------------------

# Third-party tool binaries — download via TOOLCHAIN-SETUP.md
jaguar-toolchain/bin/*.exe
jaguar-toolchain/bin/*.zip
jaguar-toolchain/emulator/**/*.exe
jaguar-toolchain/emulator/**/*.dll
jaguar-toolchain/emulator/**/*.zip
jaguar-toolchain/emulator/vjaguar/eeproms/
jaguar-toolchain/emulator/vjaguar/screenshots/

# Intermediate build artifacts for future jaguar/ work (regenerated by build)
# Note: jaguar-toolchain/hello/ outputs ARE tracked — they are Gate 1 evidence
jaguar/**/*.o
jaguar/**/*.abs
jaguar/**/*.cof
jaguar/**/*.bin.tmp

# OS / editor noise
.DS_Store
Thumbs.db
desktop.ini
*.swp
*.swo
*~
.vscode/
.idea/

# Temp dirs used during analysis
.tmp-*/
